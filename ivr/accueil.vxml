<?xml version="1.0" encoding="UTF-8"?>
<!--
  Menu vocal (SVI) de ComptaPaie Expert — numéro 01 85 09 96 60
  Format : VoiceXML 2.0, pour la configuration « Serveur vocal interactif en VXML » d'OVHcloud.

  Touche 1 = devis
  Touche 2 = candidature / stage (message seul, pas de transfert)
  Touche 3 = joindre un collaborateur
  Touche 4 = Marrakech (domiciliation, co-working)
  HORAIRES (heure de Paris, calculée dans ce fichier, heure d'été incluse) :
    - lundi au vendredi 9h30-17h30 : menu complet ;
    - samedi 9h-18h : devis uniquement (transfert direct vers le conseiller devis) ;
    - en dehors : message de fermeture horaires.wav puis fin d'appel.
    En cas d'erreur du calcul, le menu complet est joué (sécurité).
  Aucune touche = message « aucun choix » puis fin d'appel
  Touche invalide = message « choix invalide » puis fin d'appel

  POUR CHANGER UNE DESTINATION : cherchez « number/ » dans ce fichier (une fois par touche 1, 3 et 4)
  et remplacez le numéro par celui voulu, au format national sans espace (ex. number/0612345678).
  Pendant que l'appel est mis en relation, l'appelant entend la tonalité réseau standard
  (musique d'attente attente.wav retirée le 2026-09-23, pour éviter le décalage entendu après décroché).
-->
<vxml version="2.0" xml:lang="fr" xmlns="http://www.w3.org/2001/vxml">

  <property name="inputmodes" value="dtmf"/>
  <property name="timeout" value="8s"/>
  <property name="bargein" value="true"/>

  <!-- ===================== ROUTAGE SELON L'HEURE (heure de Paris) ===================== -->
  <script><![CDATA[
    function etatCabinet() {
      try {
        var d = new Date();
        var y = d.getUTCFullYear();
        var debutEte = new Date(Date.UTC(y, 2, 31, 1, 0, 0));
        debutEte.setUTCDate(31 - debutEte.getUTCDay());
        var finEte = new Date(Date.UTC(y, 9, 31, 1, 0, 0));
        finEte.setUTCDate(31 - finEte.getUTCDay());
        var decalage = (d >= debutEte && d < finEte) ? 2 : 1;
        var p = new Date(d.getTime() + decalage * 3600000);
        var jour = p.getUTCDay();
        var minutes = p.getUTCHours() * 60 + p.getUTCMinutes();
        if (jour >= 1 && jour <= 5 && minutes >= 570 && minutes < 1050) { return 'ouvert'; }
        if (jour == 6 && minutes >= 540 && minutes < 1080) { return 'samedi'; }
        return 'ferme';
      } catch (e) {
        return 'ouvert';
      }
    }
  ]]></script>

  <form id="routage">
    <catch event="error"><goto next="#accueil"/></catch>
    <block>
      <var name="etat" expr="etatCabinet()"/>
      <if cond="etat == 'ferme'">
        <goto next="#ferme"/>
      <elseif cond="etat == 'samedi'"/>
        <goto next="#devis"/>
      <else/>
        <goto next="#accueil"/>
      </if>
    </block>
  </form>

  <!-- ===================== CABINET FERMÉ ===================== -->
  <form id="ferme">
    <block>
      <prompt>
        <audio src="https://comptapaye.com/ivr/horaires.wav">
          Bonjour, et merci d'avoir appelé Compta Paie Expert ! Nos bureaux sont actuellement fermés.
          Nous vous accueillons du lundi au vendredi, de neuf heures trente à dix-sept heures trente.
          Le samedi, nous sommes joignables uniquement pour les demandes de devis, de neuf heures à dix-huit heures.
          Nous serons ravis de vous répondre pendant ces horaires. À très bientôt !
        </audio>
      </prompt>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== MENU D'ACCUEIL ===================== -->
  <menu id="accueil" dtmf="true">
    <prompt bargein="true">
      <audio src="https://comptapaye.com/ivr/accueil-menu.wav">
        Bonjour, et bienvenue chez Compta Paie Expert !
        Pour un devis, tapez 1.
        Pour une candidature ou un stage, tapez 2.
        Pour joindre un collaborateur, tapez 3.
        Pour nos services à Marrakech, domiciliation et co-working, tapez 4.
      </audio>
    </prompt>

    <choice dtmf="1" next="#devis"/>
    <choice dtmf="2" next="#candidature"/>
    <choice dtmf="3" next="#collaborateur"/>
    <choice dtmf="4" next="#maroc"/>

    <!-- aucune touche : message « aucun choix » puis fin d'appel -->
    <noinput><goto next="#aucunchoix"/></noinput>

    <!-- touche invalide : message « choix invalide » puis fin d'appel -->
    <nomatch><goto next="#invalide"/></nomatch>
  </menu>

  <!-- ===================== CHOIX INVALIDE ===================== -->
  <form id="invalide">
    <block>
      <prompt>
        <audio src="https://comptapaye.com/ivr/choix-invalide.wav">
          Oups, ce choix n'est pas valable ! N'hésitez pas à nous rappeler, nous serons ravis de vous répondre. À très bientôt !
        </audio>
      </prompt>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== AUCUN CHOIX ===================== -->
  <form id="aucunchoix">
    <block>
      <prompt>
        <audio src="https://comptapaye.com/ivr/aucun-choix.wav">
          Nous n'avons pas reçu de choix. N'hésitez pas à nous rappeler, nous serons ravis de vous répondre. À très bientôt !
        </audio>
      </prompt>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== TOUCHE 3 : JOINDRE UN COLLABORATEUR ===================== -->
  <form id="collaborateur">
    <block><prompt><audio src="https://comptapaye.com/ivr/patienter-collaborateur.wav">Un instant, nous vous mettons en relation avec un collaborateur.</audio></prompt></block>
    <transfer name="t" dest="number/0185090861" connecttimeout="25s" bridge="true"/>
    <block>
      <if cond="t == 'busy' || t == 'noanswer' || t == 'network_busy' || t == 'unknown'">
        <goto next="#indisponible"/>
      </if>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== TOUCHE 1 : DEVIS ===================== -->
  <form id="devis">
    <block><prompt><audio src="https://comptapaye.com/ivr/patienter-devis.wav">Un instant, nous vous mettons en relation avec un conseiller pour votre devis.</audio></prompt></block>
    <transfer name="t" dest="number/0184165231" connecttimeout="25s" bridge="true"/>
    <block>
      <if cond="t == 'busy' || t == 'noanswer' || t == 'network_busy' || t == 'unknown'">
        <goto next="#indisponible"/>
      </if>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== TOUCHE 4 : MARRAKECH ===================== -->
  <form id="maroc">
    <block><prompt><audio src="https://comptapaye.com/ivr/patienter-marrakech.wav">Un instant, nous vous mettons en relation avec notre équipe de Marrakech.</audio></prompt></block>
    <transfer name="t" dest="number/0185099554" connecttimeout="25s" bridge="true"/>
    <block>
      <if cond="t == 'busy' || t == 'noanswer' || t == 'network_busy' || t == 'unknown'">
        <goto next="#indisponible"/>
      </if>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== TOUCHE 2 : CANDIDATURE (message seul) ===================== -->
  <form id="candidature">
    <block>
      <prompt>
        <audio src="https://comptapaye.com/ivr/candidature.wav">
          Merci de votre intérêt pour Compta Paie Expert ! Pour une candidature ou un stage, envoyez-nous
          votre C V depuis notre site internet Compta Paie, rubrique candidature.
          Nous reviendrons vers vous très vite. Merci de votre appel, et à très bientôt !
        </audio>
      </prompt>
      <disconnect/>
    </block>
  </form>

  <!-- ===================== PERSONNE NE RÉPOND ===================== -->
  <form id="indisponible">
    <block>
      <prompt>
        <audio src="https://comptapaye.com/ivr/indisponible.wav">
          Nos conseillers sont en ligne avec d'autres clients pour le moment.
          Nous vous accueillons du lundi au vendredi, de neuf heures trente à dix-sept heures trente,
          et le samedi, pour les devis uniquement, de neuf heures à dix-huit heures.
          Vous pouvez nous écrire à contact, arobase, compta paie, point com, ou demander un devis sur notre site internet.
          Merci de votre appel, et à très bientôt !
        </audio>
      </prompt>
      <disconnect/>
    </block>
  </form>

  <!-- en cas d'erreur technique : message poli puis fin d'appel -->
  <catch event="error.badfetch error.semantic error.unsupported">
    <prompt>Le service est momentanément indisponible. Merci de rappeler plus tard.</prompt>
    <disconnect/>
  </catch>

</vxml>
